{
  "name": "babyloom",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build:icons": "tsx scripts/build-icons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "docker:build": "docker build -t babyloom:local .",
    "docker:push": "docker buildx build --platform linux/amd64 --provenance=false -t cccat5207/babyloom:$npm_package_version -t cccat5207/babyloom:latest --push .",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@serwist/next": "^9.5.11",
    "better-auth": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.36.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "file-type": "^22.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "formidable": "^3.5.4",
    "js-yaml": "^4.1.0",
    "next": "15.0.3",
    "pino": "^9.5.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "serwist": "^9.5.11",
    "sharp": "^0.34.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/formidable": "^3.5.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^2.1.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "eslint-plugin-babyloom": "file:./eslint-rules",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
